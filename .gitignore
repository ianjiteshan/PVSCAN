# =====================================
# Security & Sensitive Data
# =====================================


# Environment files containing secrets
.env
.env.local
.env.production
.env.staging
*.env

# Logs with potential sensitive data
*.log
logs/
*_log.txt
access.log
error.log

# SSL certificates and keys
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

