{"ast":null,"code":"import { PhotoIcon, FolderIcon, ShieldCheckIcon, BoltIcon, CloudIcon, BeakerIcon, CogIcon, ChartBarIcon } from '@heroicons/vue/24/outline';\nexport default {\n  name: 'HomeView',\n  components: {\n    PhotoIcon,\n    FolderIcon,\n    ShieldCheckIcon,\n    BoltIcon,\n    CloudIcon,\n    BeakerIcon,\n    CogIcon,\n    ChartBarIcon\n  },\n  data() {\n    return {\n      features: [{\n        id: 1,\n        icon: ShieldCheckIcon,\n        title: 'Physical Damage Detection',\n        description: 'Identify cracks, chips, and structural damage that could impact panel performance.'\n      }, {\n        id: 2,\n        icon: BoltIcon,\n        title: 'Electrical Issue Analysis',\n        description: 'Detect electrical problems and connection issues before they cause system failures.'\n      }, {\n        id: 3,\n        icon: CloudIcon,\n        title: 'Environmental Impact Assessment',\n        description: 'Analyze snow coverage, water obstruction, and weather-related performance impacts.'\n      }, {\n        id: 4,\n        icon: BeakerIcon,\n        title: 'Contamination Detection',\n        description: 'Identify foreign particles, dirt accumulation, and cleaning requirements.'\n      }, {\n        id: 5,\n        icon: CogIcon,\n        title: 'Automated Maintenance Suggestions',\n        description: 'Receive actionable recommendations for optimal panel maintenance and care.'\n      }, {\n        id: 6,\n        icon: ChartBarIcon,\n        title: 'Efficiency Metrics Dashboard',\n        description: 'Track performance trends and efficiency metrics across your entire installation.'\n      }],\n      stats: [{\n        value: '8+',\n        label: 'Detection Categories'\n      }, {\n        value: '98.5%',\n        label: 'Analysis Accuracy'\n      }, {\n        value: '< 2s',\n        label: 'Processing Time'\n      }, {\n        value: '24/7',\n        label: 'Availability'\n      }]\n    };\n  }\n};","map":{"version":3,"names":["PhotoIcon","FolderIcon","ShieldCheckIcon","BoltIcon","CloudIcon","BeakerIcon","CogIcon","ChartBarIcon","name","components","data","features","id","icon","title","description","stats","value","label"],"sources":["/Users/jitendrajha/Desktop/PVSCAN/pvscan-frontend/src/views/HomeView.vue"],"sourcesContent":["<template>\n  <div class=\"home-view\">\n    <!-- Hero Section -->\n    <section class=\"hero\">\n      <div class=\"hero-content\">\n        <div class=\"hero-text fade-in\">\n          <h1 class=\"hero-title\">\n            Advanced Solar Panel\n            <span class=\"gradient-text\">Inspection & Analysis</span>\n          </h1>\n          <p class=\"hero-description\">\n            Harness the power of AI to detect issues, optimize performance, and maximize efficiency \n            of your solar panel installations with our cutting-edge computer vision technology.\n          </p>\n          <div class=\"hero-actions\">\n            <router-link to=\"/single\" class=\"btn-primary\">\n              <PhotoIcon class=\"btn-icon\" />\n              Analyze Single Panel\n            </router-link>\n            <router-link to=\"/batch\" class=\"btn-secondary\">\n              <FolderIcon class=\"btn-icon\" />\n              Batch Analysis\n            </router-link>\n          </div>\n        </div>\n        \n        <div class=\"hero-visual slide-in\">\n          <div class=\"visual-card\">\n            <img src=\"/logo_phone.png\" alt=\"PVSCAN Analysis\" class=\"hero-image\" />\n            <div class=\"floating-stats\">\n              <div class=\"stat-item\">\n                <div class=\"stat-value\">98.5%</div>\n                <div class=\"stat-label\">Accuracy</div>\n              </div>\n              <div class=\"stat-item\">\n                <div class=\"stat-value\">&lt; 2s</div>\n                <div class=\"stat-label\">Analysis Time</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Features Section -->\n    <section class=\"features\">\n      <div class=\"container\">\n        <h2 class=\"section-title\">Comprehensive Analysis Capabilities</h2>\n        <div class=\"features-grid\">\n          <div class=\"feature-card\" v-for=\"feature in features\" :key=\"feature.id\">\n            <div class=\"feature-icon\">\n              <component :is=\"feature.icon\" />\n            </div>\n            <h3 class=\"feature-title\">{{ feature.title }}</h3>\n            <p class=\"feature-description\">{{ feature.description }}</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Stats Section -->\n    <section class=\"stats\">\n      <div class=\"container\">\n        <div class=\"stats-grid\">\n          <div class=\"stat-card\" v-for=\"stat in stats\" :key=\"stat.label\">\n            <div class=\"stat-number\">{{ stat.value }}</div>\n            <div class=\"stat-description\">{{ stat.label }}</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- CTA Section -->\n    <section class=\"cta\">\n      <div class=\"container\">\n        <div class=\"cta-content\">\n          <h2 class=\"cta-title\">Ready to Optimize Your Solar Installation?</h2>\n          <p class=\"cta-description\">\n            Start analyzing your solar panels today and discover insights that can improve efficiency and reduce maintenance costs.\n          </p>\n          <div class=\"cta-actions\">\n            <router-link to=\"/single\" class=\"btn-primary\">\n              Get Started Now\n            </router-link>\n            <router-link to=\"/dashboard\" class=\"btn-secondary\">\n              View Dashboard\n            </router-link>\n          </div>\n        </div>\n      </div>\n    </section>\n  </div>\n</template>\n\n<script>\nimport { \n  PhotoIcon, \n  FolderIcon,\n  ShieldCheckIcon,\n  BoltIcon,\n  CloudIcon,\n  BeakerIcon,\n  CogIcon,\n  ChartBarIcon\n} from '@heroicons/vue/24/outline'\n\nexport default {\n  name: 'HomeView',\n  components: {\n    PhotoIcon,\n    FolderIcon,\n    ShieldCheckIcon,\n    BoltIcon,\n    CloudIcon,\n    BeakerIcon,\n    CogIcon,\n    ChartBarIcon\n  },\n  data() {\n    return {\n      features: [\n        {\n          id: 1,\n          icon: ShieldCheckIcon,\n          title: 'Physical Damage Detection',\n          description: 'Identify cracks, chips, and structural damage that could impact panel performance.'\n        },\n        {\n          id: 2,\n          icon: BoltIcon,\n          title: 'Electrical Issue Analysis',\n          description: 'Detect electrical problems and connection issues before they cause system failures.'\n        },\n        {\n          id: 3,\n          icon: CloudIcon,\n          title: 'Environmental Impact Assessment',\n          description: 'Analyze snow coverage, water obstruction, and weather-related performance impacts.'\n        },\n        {\n          id: 4,\n          icon: BeakerIcon,\n          title: 'Contamination Detection',\n          description: 'Identify foreign particles, dirt accumulation, and cleaning requirements.'\n        },\n        {\n          id: 5,\n          icon: CogIcon,\n          title: 'Automated Maintenance Suggestions',\n          description: 'Receive actionable recommendations for optimal panel maintenance and care.'\n        },\n        {\n          id: 6,\n          icon: ChartBarIcon,\n          title: 'Efficiency Metrics Dashboard',\n          description: 'Track performance trends and efficiency metrics across your entire installation.'\n        }\n      ],\n      stats: [\n        { value: '8+', label: 'Detection Categories' },\n        { value: '98.5%', label: 'Analysis Accuracy' },\n        { value: '< 2s', label: 'Processing Time' },\n        { value: '24/7', label: 'Availability' }\n      ]\n    }\n  }\n}\n</script>\n\n<style scoped>\n.home-view {\n  min-height: 100vh;\n}\n\n.hero {\n  padding: 80px 24px;\n  max-width: 1200px;\n  margin: 0 auto;\n}\n\n.hero-content {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 80px;\n  align-items: center;\n}\n\n.hero-title {\n  font-size: 3.5rem;\n  font-weight: 700;\n  line-height: 1.1;\n  margin-bottom: 24px;\n  color: white;\n}\n\n.hero-description {\n  font-size: 1.25rem;\n  line-height: 1.6;\n  color: rgba(255, 255, 255, 0.9);\n  margin-bottom: 40px;\n}\n\n.hero-actions {\n  display: flex;\n  gap: 16px;\n  flex-wrap: wrap;\n}\n\n.btn-icon {\n  width: 20px;\n  height: 20px;\n}\n\n.hero-visual {\n  position: relative;\n}\n\n.visual-card {\n  position: relative;\n  background: rgba(255, 255, 255, 0.1);\n  border-radius: 24px;\n  padding: 40px;\n  backdrop-filter: blur(10px);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n}\n\n.hero-image {\n  width: 100%;\n  height: auto;\n  border-radius: 16px;\n}\n\n.floating-stats {\n  position: absolute;\n  top: -20px;\n  right: -20px;\n  display: flex;\n  gap: 16px;\n}\n\n.stat-item {\n  background: rgba(255, 255, 255, 0.95);\n  padding: 16px;\n  border-radius: 12px;\n  text-align: center;\n  box-shadow: 0 8px 32px rgba(31, 38, 135, 0.37);\n}\n\n.stat-value {\n  font-size: 1.5rem;\n  font-weight: 700;\n  color: #4f46e5;\n}\n\n.stat-label {\n  font-size: 0.875rem;\n  color: #64748b;\n  margin-top: 4px;\n}\n\n.features {\n  padding: 120px 24px;\n  background: rgba(255, 255, 255, 0.05);\n}\n\n.container {\n  max-width: 1200px;\n  margin: 0 auto;\n}\n\n.section-title {\n  font-size: 2.5rem;\n  font-weight: 700;\n  text-align: center;\n  margin-bottom: 80px;\n  color: white;\n}\n\n.features-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));\n  gap: 32px;\n}\n\n.feature-card {\n  background: rgba(255, 255, 255, 0.95);\n  padding: 32px;\n  border-radius: 16px;\n  text-align: center;\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\n  box-shadow: 0 8px 32px rgba(31, 38, 135, 0.37);\n}\n\n.feature-card:hover {\n  transform: translateY(-8px);\n  box-shadow: 0 16px 48px rgba(31, 38, 135, 0.5);\n}\n\n.feature-icon {\n  width: 64px;\n  height: 64px;\n  margin: 0 auto 24px;\n  padding: 16px;\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n  border-radius: 16px;\n  color: white;\n}\n\n.feature-icon svg {\n  width: 100%;\n  height: 100%;\n}\n\n.feature-title {\n  font-size: 1.5rem;\n  font-weight: 600;\n  margin-bottom: 16px;\n  color: #1f2937;\n}\n\n.feature-description {\n  color: #64748b;\n  line-height: 1.6;\n}\n\n.stats {\n  padding: 80px 24px;\n}\n\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 32px;\n}\n\n.stat-card {\n  text-align: center;\n  background: rgba(255, 255, 255, 0.1);\n  padding: 40px 24px;\n  border-radius: 16px;\n  backdrop-filter: blur(10px);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n}\n\n.stat-number {\n  font-size: 3rem;\n  font-weight: 700;\n  color: white;\n  margin-bottom: 8px;\n}\n\n.stat-description {\n  color: rgba(255, 255, 255, 0.8);\n  font-weight: 500;\n}\n\n.cta {\n  padding: 120px 24px;\n  background: rgba(255, 255, 255, 0.05);\n}\n\n.cta-content {\n  text-align: center;\n  max-width: 600px;\n  margin: 0 auto;\n}\n\n.cta-title {\n  font-size: 2.5rem;\n  font-weight: 700;\n  margin-bottom: 24px;\n  color: white;\n}\n\n.cta-description {\n  font-size: 1.25rem;\n  color: rgba(255, 255, 255, 0.9);\n  margin-bottom: 40px;\n  line-height: 1.6;\n}\n\n.cta-actions {\n  display: flex;\n  gap: 16px;\n  justify-content: center;\n  flex-wrap: wrap;\n}\n\n@media (max-width: 768px) {\n  .hero-content {\n    grid-template-columns: 1fr;\n    gap: 40px;\n    text-align: center;\n  }\n\n  .hero-title {\n    font-size: 2.5rem;\n  }\n\n  .floating-stats {\n    position: static;\n    justify-content: center;\n    margin-top: 24px;\n  }\n\n  .features-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .stats-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .section-title,\n  .cta-title {\n    font-size: 2rem;\n  }\n\n  .cta-actions {\n    flex-direction: column;\n    align-items: center;\n  }\n}\n</style>\n\n"],"mappings":"AA+FA,SACEA,SAAS,EACTC,UAAU,EACVC,eAAe,EACfC,QAAQ,EACRC,SAAS,EACTC,UAAU,EACVC,OAAO,EACPC,YAAW,QACN,2BAA0B;AAEjC,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IACVT,SAAS;IACTC,UAAU;IACVC,eAAe;IACfC,QAAQ;IACRC,SAAS;IACTC,UAAU;IACVC,OAAO;IACPC;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,CACR;QACEC,EAAE,EAAE,CAAC;QACLC,IAAI,EAAEX,eAAe;QACrBY,KAAK,EAAE,2BAA2B;QAClCC,WAAW,EAAE;MACf,CAAC,EACD;QACEH,EAAE,EAAE,CAAC;QACLC,IAAI,EAAEV,QAAQ;QACdW,KAAK,EAAE,2BAA2B;QAClCC,WAAW,EAAE;MACf,CAAC,EACD;QACEH,EAAE,EAAE,CAAC;QACLC,IAAI,EAAET,SAAS;QACfU,KAAK,EAAE,iCAAiC;QACxCC,WAAW,EAAE;MACf,CAAC,EACD;QACEH,EAAE,EAAE,CAAC;QACLC,IAAI,EAAER,UAAU;QAChBS,KAAK,EAAE,yBAAyB;QAChCC,WAAW,EAAE;MACf,CAAC,EACD;QACEH,EAAE,EAAE,CAAC;QACLC,IAAI,EAAEP,OAAO;QACbQ,KAAK,EAAE,mCAAmC;QAC1CC,WAAW,EAAE;MACf,CAAC,EACD;QACEH,EAAE,EAAE,CAAC;QACLC,IAAI,EAAEN,YAAY;QAClBO,KAAK,EAAE,8BAA8B;QACrCC,WAAW,EAAE;MACf,EACD;MACDC,KAAK,EAAE,CACL;QAAEC,KAAK,EAAE,IAAI;QAAEC,KAAK,EAAE;MAAuB,CAAC,EAC9C;QAAED,KAAK,EAAE,OAAO;QAAEC,KAAK,EAAE;MAAoB,CAAC,EAC9C;QAAED,KAAK,EAAE,MAAM;QAAEC,KAAK,EAAE;MAAkB,CAAC,EAC3C;QAAED,KAAK,EAAE,MAAM;QAAEC,KAAK,EAAE;MAAe;IAE3C;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}